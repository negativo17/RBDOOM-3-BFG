 /*
 ===========
+idFileSystemLocal::SavePathFallback
+
+The base path is not necessarily writable. Linux distributions install the game
+data to a system wide location like /usr/share/doom3bfg while the engine still
+wants to write runtime generated content to it, e.g. the generated/ folder with
+the .bimage and .bmodel files, screenshots or exported assets.
+
+Rebuild the given relative path inside the user writable save path instead,
+which is ~/.local/share/rbdoom3bfg on Linux. The save path is added to the
+search paths after the base path, so the redirected files are found again with
+priority when they are read back.
+
+Returns false if there is no other path left to try.
+===========
+*/
+bool idFileSystemLocal::SavePathFallback( const char* path, const char* relativePath, idStr& OSPath )
+{
+	const char* savePath = fs_savepath.GetString();
+
+	if( !savePath[0] || idStr::Icmp( path, savePath ) == 0 )
+	{
+		return false;
+	}
+
+	OSPath = BuildOSPath( savePath, gameFolder, relativePath );
+
+	CreateOSPath( OSPath );
+
+	return true;
+}
+
+/*
+===========
 idFileSystemLocal::OpenFileWrite
 ===========
 */
